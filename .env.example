# Copy this file to .env and fill in your values.

# ---- Email alerts for Critical bugs (Objective 7) ----
# When a test run ends and any Critical bug was detected, ONE email with every Critical bug
# and a screenshot of each is sent to ALERT_TO (comma-separated list of addresses).
# Set ALERTS_ENABLED=true and fill the SMTP values to send real emails.
# When disabled, the email is saved as an HTML preview in reports/alerts/.
ALERTS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# For Gmail use an "App Password" (Google Account > Security > App passwords)
SMTP_PASSWORD=your_app_password
ALERT_FROM=your_email@gmail.com
ALERT_TO=recipient1@example.com,recipient2@example.com

# ---- Ports ----
DEMO_APP_PORT=4000
DASHBOARD_PORT=3000
# Address of the dashboard used in report emails ("Open the full report" button).
# Use this computer's network address (e.g. http://192.168.1.20:3000) so colleagues can open it.
DASHBOARD_URL=http://localhost:3000

# ---- Broken link checker (tests/links.spec.ts) ----
# Start page: a path on the app under test (e.g. /) or a full URL of any website
LINK_CHECK_START_URL=/
# Maximum number of pages to crawl on that website
LINK_CHECK_MAX_PAGES=50
# Also check links that point to other websites (they are checked, not crawled)
LINK_CHECK_EXTERNAL=true
LINK_CHECK_TIMEOUT_MS=10000
