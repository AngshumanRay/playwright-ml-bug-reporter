<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Automated Bug Reporting</title>
  <% if (locals.autoRefresh) { %><meta http-equiv="refresh" content="3"><% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/dashboard.css">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='6' fill='%23d03b3b'/%3E%3Cpath d='M12 18c-2.5 0-4.5-2-4.5-4.5v-2a3 3 0 0 1 3-3h3a3 3 0 0 1 3 3v2c0 2.5-2 4.5-4.5 4.5z' fill='none' stroke='white' stroke-width='1.8'/%3E%3C/svg%3E">
</head>
<body>
<header class="topbar">
  <a class="brand" href="/">
    <span class="brand-logo"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 2 1.88 1.88M14.12 3.88 16 2M9 7.13v-1a3.003 3.003 0 1 1 6 0v1"/><path d="M12 20c-3.3 0-6-2.7-6-6v-3a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v3c0 3.3-2.7 6-6 6M12 20v-9M6.53 9C4.6 8.8 3 7.1 3 5M6 13H2M3 21c0-2.1 1.7-3.9 3.8-4M20.97 5c0 2.1-1.6 3.8-3.5 4M22 13h-4M17.2 17c2.1.1 3.8 1.9 3.8 4"/></svg></span>
    <span class="brand-text">Automated Bug Reporting<small>Playwright · ML severity · Test Runner</small></span>
  </a>
  <nav>
    <% [['/', 'Test Runner'], ['/runs', 'Run History'], ['/bugs', 'Bugs'], ['/flaky', 'Flaky Tests'], ['/analytics', 'Analytics']].forEach(([href, label]) => { %>
      <a href="<%= href %>" class="<%= (href === '/' ? currentPath === '/' : currentPath.startsWith(href)) ? 'active' : '' %>"><%= label %></a>
    <% }) %>
  </nav>
  <% const shopUrl = locals.demoAppUrl || 'http://localhost:4000'; /* default if the server did not provide it */ %>
  <a class="site-chip" href="<%= shopUrl %>/login.html" target="_blank" rel="noopener" title="Open the website under test">ShopEase ↗</a>
  <% if (locals.activeRunId) { %>
    <a class="live-chip" href="/runs/<%= activeRunId %>"><span class="pulse"></span>Run #<%= activeRunId %> in progress</a>
  <% } %>
</header>
<main>
