<%- include('partials/header') %>
<div class="runner-layout">
  <section>
    <form class="card launch raised" id="run-form" autocomplete="off" novalidate data-email-ready="<%= emailConfigured ? 'yes' : 'no' %>">
      <div class="launch-head">
        <div class="eyebrow">Test Runner</div>
        <h1>Run automated tests</h1>
        <p>Choose a suite, add who should receive the report, and press Run. The report appears here when the run finishes.</p>
      </div>
      <div class="launch-body">
        <div>
          <label class="field-label" for="suite">Test suite</label>
          <div class="select-wrap">
            <select id="suite" name="suite">
              <% suites.forEach(s => { %>
                <option value="<%= s.id %>" data-desc="<%= s.description %>" data-count="<%= s.count ?? '' %>"><%= s.name %><%= s.count ? ` (${s.count} tests)` : '' %></option>
              <% }) %>
            </select>
          </div>
          <div class="suite-info"><span class="count-chip" id="suite-count"></span><span id="suite-desc"></span></div>
        </div>

        <div>
          <label class="field-label" for="email-input">Email ID(s) for the report</label>
          <div class="email-box" id="email-box">
            <input id="email-input" type="email" inputmode="email" placeholder="name@company.com, press Enter to add more" aria-describedby="email-hint">
          </div>
          <div class="field-hint" id="email-hint">Separate several addresses with Enter, a comma or a space. Leave empty to skip the email.</div>
          <div class="notice warn" id="email-not-ready" style="display:none;margin-top:10px"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg><span class="email-warn">These addresses will not receive anything yet: no sending email account is set up on this computer. Add it once to the <code>.env</code> file (README section 6).</span></div>
        </div>

        <div>
          <span class="field-label">Send the report email</span>
          <div class="segmented" role="radiogroup" aria-label="When to send the report email">
            <label><input type="radio" name="emailMode" value="critical" checked><span>Only if a Critical bug is found</span></label>
            <label><input type="radio" name="emailMode" value="always"><span>After every run</span></label>
          </div>
        </div>

        <% if (emailConfigured) { %>
          <div class="notice ok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v16H4z" opacity="0"/><path d="m22 6-10 7L2 6"/><rect x="2" y="4" width="20" height="16" rx="2"/></svg><span>Emails are sent from <b><%= emailFrom %></b>.</span></div>
        <% } else { %>
          <div class="notice warn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg><span><b>No sending email account is set up yet</b>, so no emails will be sent. Add the sending Gmail address and App Password to the <code>.env</code> file once (README section 6). The report is always available here.</span></div>
        <% } %>

        <label class="switch-row">
          <span><b>Show the browser while testing</b><br><span class="muted" style="font-size:13px">Headed mode: a browser window opens and you can watch each test, one at a time</span></span>
          <span class="switch"><input type="checkbox" id="headed" checked><span></span></span>
        </label>

        <div class="form-error" id="form-error" role="alert"></div>
        <button type="submit" class="run-btn" id="run-btn">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l10.6-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14z"/></svg>
          <span>Run tests</span>
        </button>
      </div>
    </form>

    <div class="card live raised" id="live">
      <div class="live-head">
        <div class="live-title"><span class="spinner" id="live-spinner"></span><span id="live-name">Starting…</span></div>
        <div style="display:flex;gap:8px">
          <a class="btn ghost small" id="live-open" href="#">Open report</a>
          <button type="button" class="danger small" id="stop-btn">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2"/></svg>Stop
          </button>
        </div>
      </div>
      <div class="progress" aria-hidden="true"><div class="p" id="bar-pass" style="width:0"></div><div class="f" id="bar-fail" style="width:0"></div></div>
      <div class="live-stats">
        <span><b id="st-done">0</b> of <b id="st-planned">–</b> tests done</span>
        <span><i class="dot" style="--c: var(--pass)"></i><b id="st-pass">0</b> passed</span>
        <span><i class="dot" style="--c: var(--fail)"></i><b id="st-fail">0</b> failed</span>
        <span>Elapsed <b id="st-time">0s</b></span>
      </div>
      <div id="done-slot"></div>
      <ul class="live-list" id="live-list"></ul>
      <details>
        <summary>Show live Playwright log</summary>
        <div class="console" id="console"></div>
      </details>
    </div>
  </section>

  <aside class="card">
    <div class="card-title"><h2>Recent runs</h2><a href="/runs" class="muted" style="font-size:13px">All runs →</a></div>
    <ul class="run-list" id="recent">
      <% if (!recent.length) { %><li class="empty">No runs yet. Your first run will appear here.</li><% } %>
      <% recent.forEach(r => { const pct = r.total ? (r.passed / r.total) * 100 : 0; %>
        <li><a class="run-item run-<%= r.status %>" href="/runs/<%= r.id %>">
          <span class="stripe"></span>
          <span style="min-width:0"><span class="when"><%= r.date %> <%= r.time %></span><br><span class="what"><%= r.suite %> · Run #<%= r.id %></span></span>
          <span class="score"><%= r.status === 'running' ? 'running…' : `${r.passed}/${r.total} passed` %>
            <span class="mini-bar"><span class="p" style="width:<%= pct %>%"></span><span class="f" style="width:<%= r.total ? (r.failed / r.total) * 100 : 0 %>%"></span></span></span>
        </a></li>
      <% }) %>
    </ul>
  </aside>
</div>
<script src="/static/runner.js"></script>
<%- include('partials/footer') %>
