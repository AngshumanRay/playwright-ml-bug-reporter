<%- include('partials/header') %>
<h1>Flaky Test Detection</h1>
<p class="subtitle">A test is <b>flaky</b> when it both passed and failed within the last <%= windowRuns %> runs (minimum <%= minRuns %> runs) without any code change.
Flip rate = how often the result changed between consecutive runs.</p>

<% const flaky = stability.filter(s => s.verdict === 'Flaky'); %>
<div class="card table-wrap" style="margin-bottom:16px">
  <h2 class="section-title" style="margin-top:0">Flaky tests (<%= flaky.length %>)</h2>
  <% if (!flaky.length) { %>
    <p class="empty">No flaky tests detected yet. Run the suite several times: <code>npm run pipeline</code></p>
  <% } else { %>
  <table>
    <tr><th>Test</th><th>Module</th><th class="num">Runs</th><th class="num">Passed</th><th class="num">Failed</th><th>Failure rate</th><th class="num">Flip rate</th><th>History</th></tr>
    <% flaky.forEach(s => { %>
    <tr>
      <td><%= s.title %></td><td><%= s.module %></td>
      <td class="num"><%= s.runs %></td><td class="num"><%= s.passed %></td><td class="num"><%= s.failed %></td>
      <td style="min-width:140px"><div class="bar"><div style="width: <%= (s.failureRate * 100).toFixed(0) %>%"></div></div><span class="muted" style="font-size:12px"><%= (s.failureRate * 100).toFixed(0) %>%</span></td>
      <td class="num"><%= (s.flipRate * 100).toFixed(0) %>%</td>
      <td class="history"><% s.history.split('').forEach(c => { %><span class="<%= c %>"><%= c %></span><% }) %></td>
    </tr>
    <% }) %>
  </table>
  <% } %>
</div>

<div class="card table-wrap">
  <h2 class="section-title" style="margin-top:0">All tests - stability</h2>
  <table>
    <tr><th>Test</th><th>Module</th><th>Verdict</th><th class="num">Runs</th><th class="num">Failure rate</th><th>History</th></tr>
    <% stability.forEach(s => { %>
    <tr>
      <td><%= s.title %></td><td><%= s.module %></td>
      <td><span class="pill <%= s.verdict === 'Flaky' ? 'flaky-tag' : s.verdict === 'Stable' ? 'ok-tag' : s.verdict === 'Consistently failing' ? 'fail-tag' : '' %>"><%= s.verdict %></span></td>
      <td class="num"><%= s.runs %></td>
      <td class="num"><%= (s.failureRate * 100).toFixed(0) %>%</td>
      <td class="history"><% s.history.split('').forEach(c => { %><span class="<%= c %>"><%= c %></span><% }) %></td>
    </tr>
    <% }) %>
  </table>
</div>
<%- include('partials/footer') %>
