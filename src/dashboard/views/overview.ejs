<%- include('partials/header') %>
<h1>Defect Overview</h1>
<p class="subtitle">Bugs captured automatically from Playwright test runs, with severity predicted by the ML model.</p>

<section class="grid kpis">
  <div class="card kpi"><div class="label">Total bugs</div><div class="value"><%= counts.totalBugs %></div><div class="hint"><%= counts.resolvedBugs %> resolved</div></div>
  <div class="card kpi"><div class="label">Open</div><div class="value"><%= counts.openBugs %></div><div class="hint"><%= counts.inProgressBugs %> in progress</div></div>
  <div class="card kpi"><div class="label"><span class="pill sev-Critical">Critical</span> not resolved</div><div class="value"><%= counts.criticalOpen %></div><div class="hint">email alert on detection</div></div>
  <div class="card kpi"><div class="label">Flaky tests</div><div class="value"><%= flakyCount %></div><div class="hint"><a href="/flaky">see analysis</a></div></div>
  <div class="card kpi"><div class="label">Test runs</div><div class="value"><%= counts.totalRuns %></div><div class="hint"><a href="/runs">run history</a></div></div>
</section>

<section class="grid charts">
  <div class="card chart-card">
    <h2>Bugs per module</h2>
    <p>Which part of the application has the most defects</p>
    <div class="chart-box"><canvas id="moduleChart" aria-label="Bugs per module bar chart" role="img"></canvas></div>
    <details><summary>View data table</summary>
      <table><tr><th>Module</th><th class="num">Bugs</th></tr>
      <% analytics.perModule.forEach(r => { %><tr><td><%= r.module %></td><td class="num"><%= r.count %></td></tr><% }) %></table>
    </details>
  </div>
  <div class="card chart-card">
    <h2>Severity distribution</h2>
    <p>Critical / Major / Minor as predicted by the ML model</p>
    <div class="chart-box"><canvas id="severityChart" aria-label="Severity distribution bar chart" role="img"></canvas></div>
    <details><summary>View data table</summary>
      <table><tr><th>Severity</th><th class="num">Bugs</th></tr>
      <% analytics.severity.forEach(r => { %><tr><td><%- include('partials/sev', { severity: r.severity }) %></td><td class="num"><%= r.count %></td></tr><% }) %></table>
    </details>
  </div>
  <div class="card chart-card wide">
    <h2>Bug trend - last 14 days</h2>
    <p>New bugs detected per day, by severity</p>
    <div class="legend">
      <span style="--c: var(--critical)">Critical</span><span style="--c: var(--major)">Major</span><span style="--c: var(--minor)">Minor</span>
    </div>
    <div class="chart-box"><canvas id="trendChart" aria-label="14-day bug trend stacked bar chart" role="img"></canvas></div>
    <details><summary>View data table</summary>
      <table><tr><th>Date</th><th class="num">Critical</th><th class="num">Major</th><th class="num">Minor</th></tr>
      <% analytics.trend.forEach(r => { %><tr><td><%= r.date %></td><td class="num"><%= r.Critical %></td><td class="num"><%= r.Major %></td><td class="num"><%= r.Minor %></td></tr><% }) %></table>
    </details>
  </div>
</section>

<section class="card">
  <h2 class="section-title" style="margin-top:0">Latest test runs</h2>
  <%- include('partials/runs-table', { runs }) %>
</section>

<script id="analytics-data" type="application/json"><%- JSON.stringify(analytics).replace(/</g, '\\u003c') %></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"></script>
<script src="/static/charts.js"></script>
<%- include('partials/footer') %>
